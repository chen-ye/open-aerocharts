{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/public/metadata.json",
			"!**/public/search_index.json"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off",
				"noArrayIndexKey": "off"
			},
			"complexity": {
				"noImportantStyles": "off",
				"useOptionalChain": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	}
}
